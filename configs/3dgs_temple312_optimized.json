{
  "method": "3dgs",
  "iterations": 10000,
  "learning_rate": 0.001,
  "image_downscale": 1,
  "rays_per_batch": 256,
  "samples_per_ray": 32,
  "near": 0.1,
  "far": 4.0,
  "holdout_every": 20,
  "seed": 0,
