{
  "name": "minicolmap-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "format": "prettier --write src e2e vite.config.ts tsconfig.json package.json index.html README.md",
    "format:check": "prettier --check src e2e vite.config.ts tsconfig.json package.json index.html README.md",
    "test:e2e": "node e2e/workbench.mjs",
    "test:e2e:camera": "node e2e/camera-view.mjs",
    "test:e2e:rendering": "node e2e/novel-view.mjs",
    "test:e2e:rendering:todo": "node e2e/rendering-live-todo.mjs",
    "test:e2e:posed-input": "node e2e/posed-input-live.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
